# ==============================================================
# RAG Healthcare Assistant — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================


# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Full Prisma-compatible connection string.
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb

# Used by docker-compose and StatefulSet env interpolation
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb


# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379


# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=healthcare-knowledge


# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_LLM_MODEL=gpt-4


# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022


# ── LLM / Embedding provider selection ───────────────────────────────────────
# Options: openai | anthropic
LLM_PROVIDER=openai
# Options: openai
EMBEDDING_PROVIDER=openai


# ── Security ──────────────────────────────────────────────────────────────────
# JWT_SECRET: minimum 32 random characters
JWT_SECRET=replace-with-at-least-32-chars-random-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ENCRYPTION_KEY: exactly 64 hex characters (32-byte AES-256 key)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars_generate_with_openssl_rand_hex_32_output


# ── RAG pipeline settings ─────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVAL_DOCS=5
SIMILARITY_THRESHOLD=0.75
MAX_DOCUMENT_SIZE_MB=50


# ── Admin bootstrap credentials ───────────────────────────────────────────────
# Used to seed the initial admin user on first startup.
ADMIN_EMAIL=admin@yourhospital.org
ADMIN_PASSWORD=AdminPassword123!@#


# ── Rate limiting ─────────────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS: sliding window size in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX: maximum requests per window per IP
RATE_LIMIT_MAX=100


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ── Monitoring — Elasticsearch / ELK Stack ────────────────────────────────────
ENABLE_METRICS=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTIC_PASSWORD=elasticpassword


# ── Monitoring — Datadog (optional) ──────────────────────────────────────────
# Leave blank to disable Datadog integration
DATADOG_API_KEY=


# ── Monitoring — Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=grafanapassword


# ── AWS (required for ECR push and EKS deployment) ───────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# For local dev with IAM user credentials (prefer OIDC/instance profiles in prod)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
